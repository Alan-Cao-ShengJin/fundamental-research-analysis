            "concrete-evidence",
            "affected-risk-review",
            "model-recalculation",
            "model-audit",
            "downstream-refresh"
          ],
          "escalateTo": "major",
          "forecastChangeStages": [
            "revision-risk-review",
            "model-revision",
            "revision-audit"
          ]
        },
        "major": {
          "flow": "company-update",
          "forecastPolicy": "evaluate-then-recalibrate",
          "trigger": "Earnings or material catalyst evidence requiring substantial reassessment.",
          "learningStage": "revision-forecast-evaluation"
        }
      }
    }
