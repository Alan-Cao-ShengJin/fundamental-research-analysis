      "routingReference": "research-cycle/references/request-routing.md",
      "modes": {
        "regular": {
          "flow": "company-regular-review",
          "forecastPolicy": "retain-unless-supported-change",
          "trigger": "Existing coverage between major disclosures; check intervening concrete evidence and refresh valuation/return.",
