    {
     "id": "gross_chargeoffs",
     "label": "Gross chargeoffs",
     "unit": "currency",
     "value": 5
    },
    {
     "id": "recoveries",
     "label": "Recoveries",
     "unit": "currency",
     "value": 1
    },
    {
     "id": "capital_open",
     "label": "Capital open",
     "unit": "currency",
     "value": 70
    },
    {
     "id": "retained_profit_before_dividend",
     "label": "Retained profit before dividend",
     "unit": "currency",
     "value": 12
    },
    {
     "id": "dividend",
     "label": "Dividend",
     "unit": "currency",
     "value": 5
    },
    {
     "id": "risk_weighted_assets",
     "label": "Risk weighted assets",
     "unit": "currency",
     "value": 700
    }
   ],
   "calculations": [
    {
     "id": "nii",
     "label": "Net interest income",
     "unit": "currency",
     "formula": "(average_earning_assets * asset_yield - average_interest_funding * funding_cost) * period_fraction"
    },
    {
     "id": "allowance_close",
     "label": "Allowance close",
     "unit": "currency",
     "formula": "allowance_open + provision - gross_chargeoffs + recoveries"
    },
    {
     "id": "capital_close",
     "label": "Capital close",
     "unit": "currency",
     "formula": "capital_open + retained_profit_before_dividend - dividend"
    },
    {
     "id": "capital_ratio",
     "label": "Capital / risk-weighted assets",
     "unit": "ratio",
     "formula": "capital_close / risk_weighted_assets"
    }
   ],
   "expected": {
    "nii": 33,
    "allowance_close": 20,
    "capital_close": 77,
    "capital_ratio": 0.11
   }
  },
