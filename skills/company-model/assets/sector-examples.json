{
 "synthetic": true,
 "purpose": "Independently invented arithmetic miniatures, not full forecasts or empirical base rates. Replace every input and adapt the activity structure for real work.",
 "cases": {
  "saas": {
   "scope": "One-year contractual recurring-value bridge. Average ARR is an illustrative linear recognition proxy, not an accounting identity.",
   "inputs": [
    {
     "id": "arr_open",
     "label": "Opening annual recurring revenue",
     "unit": "currency/year",
     "value": 100
    },
    {
     "id": "arr_new",
     "label": "Arr new",
     "unit": "currency/year",
     "value": 25
    },
    {
     "id": "arr_expansion",
     "label": "Arr expansion",
     "unit": "currency/year",
     "value": 15
    },
    {
     "id": "arr_churn",
     "label": "Arr churn",
     "unit": "currency/year",
     "value": 10
    }
   ],
   "calculations": [
    {
     "id": "arr_close",
     "label": "Closing annual recurring revenue",
     "unit": "currency/year",
     "formula": "arr_open + arr_new + arr_expansion - arr_churn"
    },
    {
     "id": "net_retention",
     "label": "Net revenue retention",
     "unit": "ratio",
     "formula": "(arr_open + arr_expansion - arr_churn) / arr_open"
    },
    {
     "id": "linear_recognition_proxy",
     "label": "Recognised revenue | linear timing proxy",
     "unit": "currency",
     "formula": "(arr_open + arr_close) / 2"
    }
   ],
   "expected": {
    "arr_close": 130,
    "net_retention": 1.05,
    "linear_recognition_proxy": 115
   }
  },
  "semiconductors": {
   "scope": "One-period capacity, yield and output-sales check; no full cost or node forecast.",
   "inputs": [
    {
     "id": "wafer_capacity",
     "label": "Wafer capacity",
     "unit": "wafers/period",
     "value": 1000
    },
    {
     "id": "utilisation",
     "label": "Utilisation",
     "unit": "ratio",
     "value": 0.8
    },
    {
     "id": "dies_per_wafer",
     "label": "Dies per wafer",
     "unit": "dies/wafer",
     "value": 100
    },
    {
     "id": "yield_rate",
     "label": "Yield rate",
     "unit": "ratio",
     "value": 0.9
    },
    {
     "id": "opening_stock",
     "label": "Opening stock",
     "unit": "dies",
     "value": 1000
    },
    {
     "id": "sold_dies",
     "label": "Sold dies",
     "unit": "dies",
     "value": 70000
    },
    {
     "id": "die_net_price",
     "label": "Die net price",
     "unit": "currency/die",
     "value": 2
    }
   ],
   "calculations": [
    {
     "id": "wafer_starts",
     "label": "Wafer starts",
     "unit": "wafers",
     "formula": "wafer_capacity * utilisation"
    },
    {
     "id": "good_dies",
     "label": "Good dies",
     "unit": "dies",
     "formula": "wafer_starts * dies_per_wafer * yield_rate"
    },
    {
     "id": "closing_stock",
     "label": "Closing stock",
     "unit": "dies",
     "formula": "opening_stock + good_dies - sold_dies"
    },
    {
     "id": "revenue",
     "label": "Revenue",
     "unit": "currency",
     "formula": "sold_dies * die_net_price"
    }
   ],
   "expected": {
    "wafer_starts": 800,
    "good_dies": 72000,
    "closing_stock": 3000,
    "revenue": 140000
   }
  },
