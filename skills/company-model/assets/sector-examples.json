  "banks": {
   "scope": "Annual NII, allowance and capital miniature. Charge-offs are gross; recoveries enter once. Regulatory requirements are not supplied.",
   "inputs": [
    {
     "id": "average_earning_assets",
     "label": "Average earning assets",
     "unit": "currency",
     "value": 1000
    },
