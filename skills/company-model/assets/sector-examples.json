    {
     "id": "unhedged_realisation",
     "label": "Unhedged realisation",
     "unit": "currency/barrel",
     "formula": "benchmark - differential"
    },
    {
     "id": "realisation",
     "label": "Realisation",
     "unit": "currency/barrel",
     "formula": "unhedged_realisation + hedged_share * (hedge_price - benchmark)"
    },
    {
     "id": "cash_before_tax_growth_other",
     "label": "Cash after sustaining investment | before tax and other costs",
     "unit": "currency",
     "formula": "sold_volume_proxy * (realisation - cash_unit_cost) - sustaining_cash"
    }
