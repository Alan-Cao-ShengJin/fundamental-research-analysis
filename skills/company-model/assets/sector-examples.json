     "label": "Decline rate",
     "unit": "ratio",
     "value": 0.1
    },
    {
     "id": "new_daily_rate",
     "label": "New daily rate",
     "unit": "barrels/day",
     "value": 20
    },
    {
     "id": "days",
     "label": "Days",
     "unit": "days",
     "value": 365
    },
    {
     "id": "benchmark",
     "label": "Benchmark",
     "unit": "currency/barrel",
     "value": 70
    },
    {
     "id": "differential",
     "label": "Differential",
     "unit": "currency/barrel",
     "value": 5
    },
    {
     "id": "hedged_share",
     "label": "Hedged share",
     "unit": "ratio",
     "value": 0.2
    },
    {
     "id": "hedge_price",
     "label": "Benchmark hedge strike (differential still applies)",
     "unit": "currency/barrel",
     "value": 60
    },
    {
     "id": "cash_unit_cost",
     "label": "Cash unit cost",
     "unit": "currency/barrel",
     "value": 20
    },
    {
     "id": "sustaining_cash",
     "label": "Sustaining cash",
     "unit": "currency",
     "value": 300000
    }
   ],
   "calculations": [
    {
     "id": "closing_daily_rate",
     "label": "Closing daily rate",
     "unit": "barrels/day",
     "formula": "opening_daily_rate * (1 - decline_rate) + new_daily_rate"
    },
    {
     "id": "sold_volume_proxy",
     "label": "Sold volume proxy",
     "unit": "barrels",
     "formula": "(opening_daily_rate + closing_daily_rate) / 2 * days"
